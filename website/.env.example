# HandCash OAuth
HANDCASH_APP_ID=
HANDCASH_APP_SECRET=
HOUSE_AUTH_TOKEN=

# Supabase (self-hosted on Hetzner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BSV Inscription
BITSIGN_TREASURY_PRIVATE_KEY=

# Encryption
API_KEY_ENCRYPTION_SECRET=

# bWallet (bApp) login — signs the session tokens issued after a BRC-100 challenge.
# Any long random string. Falls back to API_KEY_ENCRYPTION_SECRET; required in production.
MINT_SESSION_SECRET=
# bWallet paymail server (identity key -> $handle lookup). Default: https://pay.bwallet.space
BWALLET_PAYMAIL_API=

# AWS SES Email
AWS_SES_REGION=eu-north-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@bitcoin-mint.com

# App
NEXT_PUBLIC_APP_URL=https://bitcoin-mint.com
